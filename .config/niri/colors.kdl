layout {
	background-color "#1e100e"

    focus-ring {
        active-color "#ffb4ac"
        inactive-color "#a38b88"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb4ac"
        inactive-color "#a38b88"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb4ac"
        inactive-color "#a38b88"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb4ac80"
    }
}

overview {
	backdrop-color "#1e100e"
}

recent-windows {
    highlight {
        active-color "#ffb4ac"
        urgent-color "#ffb4ab"
    }
}