layout {
	background-color "#1c1014"

    focus-ring {
        active-color "#ffb0c9"
        inactive-color "#a18b91"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb0c9"
        inactive-color "#a18b91"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb0c9"
        inactive-color "#a18b91"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb0c980"
    }
}

overview {
	backdrop-color "#1c1014"
}

recent-windows {
    highlight {
        active-color "#ffb0c9"
        urgent-color "#ffb4ab"
    }
}